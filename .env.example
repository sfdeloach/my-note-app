# =============================================================================
# PRODUCTION CONFIG EXAMPLE
# -----------------------------------------------------------------------------
# By default it will use SQLite, but that's mostly to test and evaluate the
# server. So you'll want to specify db connection settings to use Postgres.
# =============================================================================

APP_BASE_URL=http://localhost:22300/joplin
APP_PORT=22300

DB_CLIENT=pg

POSTGRES_USER=joplin
POSTGRES_PASSWORD=[enter-strong-password-here]
POSTGRES_DATABASE=joplin
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

MAILER_ENABLED=1
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_SECURITY=starttls
MAILER_AUTH_USER=[enter-email]
MAILER_AUTH_PASSWORD=[16-char-password-here]
MAILER_NOREPLY_NAME=JoplinServer
MAILER_NOREPLY_EMAIL=[enter-email]

# S3 bucket for encrypted backups (Stage 3+)
BACKUP_S3_BUCKET=[your-s3-bucket-name]

# healthchecks.io (or compatible) dead-man's-switch ping URL for backup.sh
# (Stage 4). Treat this like a secret: anyone with this URL can fake a
# "success" ping (silencing real failure alerts) or trigger a manual
# /fail alert. Get this from your healthchecks.io check's detail page.
BACKUP_HEALTHCHECK_URL=[https://hc-ping.com/your-uuid-here]

# healthchecks.io (or compatible) dead-man's-switch ping URL for monitor.sh
# (Stage 6) — a SEPARATE check from BACKUP_HEALTHCHECK_URL above, so a
# monitoring alert and a backup alert are distinguishable by which check
# fired. Same secret-handling caveats apply.
MONITOR_HEALTHCHECK_URL=[https://hc-ping.com/your-other-uuid-here]

# Path to the FILE containing the gpg backup passphrase — never the
# passphrase itself. Must live outside this repo (this file's own copy of
# .env gets bundled into every backup archive, so a passphrase stored here
# would defeat the point of encrypting the archive). Target file must be
# mode 600, in a directory mode 700, owned by the user cron runs as.
BACKUP_GPG_PASSPHRASE_FILE=/home/steven/.secrets/[file goes here]

# agenda-service config (docs/agenda-service/roadmap.md Stage 6). All of
# it is consumed by compose.yml, even the values that are effectively
# fixed by this stack's topology (e.g. AGENDA_DB_HOST is always the
# "database" service's Compose DNS name) — kept here rather than
# hardcoded in compose.yml to match how the rest of this file works.
#
# Password for the dedicated read-only "agenda_reader" Postgres role
# (Stage 2) — SELECT-only on `items`, never the `joplin` credentials.
AGENDA_DB_PASSWORD=[enter-strong-password-here]
AGENDA_DB_HOST=database
AGENDA_DB_PORT=5432
AGENDA_DB_NAME=joplin
AGENDA_DB_USER=agenda_reader
# Path INSIDE the agenda-service container where settings.json is
# bind-mounted read-only (see compose.yml) — not a path on the Pi's own
# filesystem.
AGENDA_SETTINGS_PATH=/etc/agenda-service/settings.json
AGENDA_LISTEN_ADDR=:8080

# =============================================================================
# DEV CONFIG EXAMPLE
# -----------------------------------------------------------------------------
# Example of local config, for development. In dev mode, you would usually use
# SQLite so database settings are not needed.
# =============================================================================
#
# APP_BASE_URL=http://localhost:22300
# APP_PORT=22300
