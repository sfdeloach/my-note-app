<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Session Meeting Minutes</title>
    <style>
      {{template "printstyle" .}}

      header,
      footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr;
        margin-bottom: 2rem;
      }

      header h1,
      h2,
      h3 {
        margin: 0;
        padding: 0;
      }

      /* h3 appears only as a Member Updates table title; give it back a
         little space above so it doesn't butt against the table before
         it. */
      h3 {
        margin-top: 1rem;
      }

      table {
        border-collapse: collapse;
        margin-bottom: 1rem;
      }

      table,
      th,
      td {
        border: 1px solid #ddd;
      }

      th {
        text-align: left;
        padding: 0.5rem;
      }

      td {
        padding: 0.25rem 0.5rem;
      }

      /* table-header-group is already the default for thead; state it so a
         table that breaks across printed pages keeps repeating its head. */
      @media print {
        thead {
          display: table-header-group;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div>
        <h2>{{.Church}}</h2>
      </div>
      <div>
        <h2>Session Meeting Minutes</h2>
        <h2>{{.MeetingDate}}</h2>
      </div>
    </header>

    <p>
      The Saint Andrew&rsquo;s Session held a
      <strong>{{.TypeLower}} meeting</strong> in {{.Location}}. The meeting
      was called to order at {{.Time}}.
    </p>

    <p>
      <strong> Session Members Present: </strong>
      {{.Present}}
    </p>

    <p>
      <strong> Session Members Absent: </strong> {{.Absent}}
    </p>

    {{range .Entries}} {{if .Motion}}
    <p><strong>Motion</strong> {{.Value}}</p>
    {{else}}
    <p>{{.Value}}</p>
    {{end}} {{end}}

    {{if .MemberUpdates}}
    <h2>Member Updates</h2>
    {{range .MemberUpdates}}
    <h3>{{.Title}}</h3>
    <table>
      <thead>
        <tr>
          {{range .Headers}}<th>{{.}}</th>{{end}}
        </tr>
      </thead>
      <tbody>
        {{range .Rows}}
        <tr>
          {{range .}}<td>{{.}}</td>{{end}}
        </tr>
        {{end}}
      </tbody>
    </table>
    {{end}}
    {{end}}

    <footer>
      <div>
        <p>Attested by Clerk {{.Clerk}}</p>
        <p>Signature: ___________________________</p>
        <p>Date: _______________</p>
      </div>
      <div>
        <p>Attested by Moderator {{.Moderator}}</p>
        <p>Signature: ___________________________</p>
        <p>Date: _______________</p>
      </div>
    </footer>
  </body>
</html>
